  "homepage": ".",
  "dependencies": {
    "@apollo/react-hooks": "^3.1.3",
    "@material-ui/core": "^4.6.1",
    "@material-ui/icons": "^4.5.1",
    "apollo-boost": "^0.4.4",
    "downshift": "^3.2.10",
    "graphql": "^14.5.8",
    "json5": "^2.2.3",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "notistack": "^0.6.1",
    "react": "^16.12.0",
    "react-apollo": "^3.1.3",
    "react-dom": "^16.12.0",
    "react-router": "^5.1.2",
    "react-router-dom": "^5.1.2",
    "recharts": "^1.8.5",
    "typeface-roboto": "^0.0.54",
    "typescript": "^3.7.2"
  },
  "devDependencies": {
    "@types/graphql": "^14.0.7",
    "@types/jest": "^24.0.15",
    "@types/moment-timezone": "^0.5.12",
    "@types/node": "11.11.3",
    "@types/react": "16.8.8",
    "@types/react-dom": "^16.9.4",
    "@types/react-router": "^5.0.1",
    "@types/react-router-dom": "^5.1.2",
    "@types/recharts": "^1.8.3",
    "apollo": "^2.21.0",
    "prettier": "^1.19.1",
    "react-scripts": "^3.2.0",
    "tslint": "^5.20.1",
    "tslint-sonarts": "^1.9.0"
  },
  "scripts": {
    "lint": "tslint --fix --project .",
    "lint:check": "tslint --project .",
    "generate": "apollo client:codegen --target typescript --localSchemaFile ../schema.graphql --excludes **/*local.ts --globalTypesFile src/gql/__generated__/globalTypes.ts",
    "format": "prettier \"**/*.{html,ts,tsx,css}\" --write",
    "format:check": "prettier \"**/*.{html,ts,tsx,css}\" --list-different",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "rimraf build/**/*.map",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "proxy": "http://localhost:3030"
}
